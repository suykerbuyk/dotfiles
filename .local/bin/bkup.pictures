#!/bin/bash
echo "Backing Pictures up to the the vault"
rsync -avr ~/Pictures/ vault01:/ark01/srv/media/pictures/ $@
ping -c 1 -W 1 -w 1 -q s76 2>&1 >/dev/null || exit 0
echo "Backing up Pictures to S76"
rsync -avzr ~/Pictures/ s76:Pictures/ --delete-after $@
ping -c 1 -W 1 -w 1 -q um791 2>&1 >/dev/null || exit 0
echo "Backing up Pictures to um791"
rsync -avzr ~/Pictures/ um791:Pictures/ --delete-after $@
