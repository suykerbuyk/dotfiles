#!/usr/bin/env sh
# doctor — report tool/env health and the exact installer for anything missing.
#
# Repo-root management CLI (not applied into ~). After apply, also available as
# ~/.local/bin/dotfiles-doctor (trampoline into this script).
#
# Usage:
#   ./doctor
#   ./doctor -h
set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)
# shellcheck source=lib/df-common.sh
. "${ROOT}/lib/df-common.sh"
df_init "${ROOT}/doctor" || exit 1
# shellcheck source=lib/doctor-registry.sh
. "${ROOT}/lib/doctor-registry.sh"
# shellcheck source=lib/doctor-report.sh
. "${ROOT}/lib/doctor-report.sh"

case ${1-} in
-h | --help | help)
	awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next}{exit}' "$0"
	exit 0
	;;
esac

df_doctor_report

# Self-heal delta's git wiring. This is the ONE case where doctor mutates state
# instead of only reporting it: when delta cannot run, the five git keys the
# delta fetcher owns are removed, because core.pager naming a non-runnable binary
# does not degrade — `git diff` dies outright (exit 128). Silent unless something
# was actually removed. Implementation and rationale: lib/df-common.sh.
#
# Deliberately narrow, and NOT a licence for other checks to start self-healing:
# the blast radius is five keys we set ourselves, only when their target is
# broken.
df_delta_gitconfig_reconcile
