{
  "agent": {
    "default_model": {
      "enable_thinking": false,
      "model": "grok-code-fast-1",
      "provider": "x_ai"
    },
    "inline_assistant_model": {
      "model": "claude-sonnet-4-5-thinking",
      "provider": "zed.dev"
    },
    "play_sound_when_agent_done": true,
    "show_turn_stats": true,
    "tool_permissions": {
      "default": "allow"
    },
    "use_modifier_to_send": true
  },
  "buffer_font_size": 12,
  "context_servers": {
    "vibe-vault": {
      "command": {
        "args": [
          "mcp"
        ],
        "path": "vv"
      }
    }
  },
  "language_models": {
    "completion": {
      "default_model": "grok-4",
      "inline_assistant": {
        "enabled": true,
        "model": "grok-4"
      },
      "provider": "xai",
      "thread": {
        "model": "grok-4"
      }
    },
    "providers": {
      "xai": {
        "models": [
          {
            "model": "grok-4",
            "name": "Grok 4"
          },
          {
            "max_tokens": 8192,
            "model": "grok-code-fast-1",
            "name": "Grok Code Fast 1",
            "temperature": 0.7
          }
        ]
      }
    }
  },
  "ssh_connections": [
    {
      "args": [],
      "host": "um791",
      "projects": [
        {
          "paths": [
            "/home/johns/code/proteus"
          ]
        },
        {
          "paths": [
            "/home/johns/code/proteus/proteus-emp-fixes/./"
          ]
        },
        {
          "paths": [
            "/home/johns/code/proteus/proteus-hvpc-support/./"
          ]
        },
        {
          "paths": [
            "/home/johns/code/proteus/proteus-registry"
          ]
        },
        {
          "paths": [
            "/home/johns/code/proteus/proteus-rs"
          ]
        }
      ]
    }
  ],
  "terminal": {
    "dock": "right",
    "shell": {
      "program": "/bin/bash"
    }
  },
  "theme": {
    "dark": "One Dark",
    "light": "Ayu Dark",
    "mode": "system"
  },
  "ui_font_size": 16,
  "vim_mode": true,
  "which_key": {
    "enabled": true
  }
}
