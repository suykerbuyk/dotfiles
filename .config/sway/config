#input "type:keyboard" xkb_options caps:swapescape

include /etc/sway/config.d/*
exec --no-startup-id systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
#exec hash dbus-update-activation-environment 2>/dev/null
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK

exec /usr/bin/1password
exec nm-applet --indicator
exec /usr/bin/blueman-tray
exec swayidle  timeout 3600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'

# Add swaync to autostart
exec swaync



mode "print" {
    bindsym y exec grim -g "$(slurp)" - | wl-copy; mode "default"
    bindsym g exec grim -g "$(slurp)" "$(xdg-user-dir PICTURES)/Grimshot $(date +%c).png"; mode "default"
    bindsym s exec grim -g "$(slurp)" - | swappy -f -; mode "default"
    bindsym o exec 'swaymsg "output * power off"; sleep 2 ; swaymsg "output * power on"'
    bindsym w exec swaymsg -t get_tree | jq -r '.. | (.nodes? // empty)[] | select(.focused) | "\(.rect.x),\(.rect.y) \(.rect.width)x\(.rect.height)"' | grim -g - - | swappy -f -; mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Print mode "print"


