{
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "model": "gpt-5.4",
      "provider": "copilot_chat"
    },
    "inline_assistant_model": {
      "model": "claude-sonnet-4-5-thinking",
      "provider": "zed.dev"
    },
    "play_sound_when_agent_done": "always",
    "show_turn_stats": true,
    "tool_permissions": {
      "tools": {
        "delete_path": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        }
      },
      "default": "allow"
    },
    "use_modifier_to_send": true
  },
  "buffer_font_size": 12,
  "context_servers": {
    "vibe-palace": {
      "args": [
        "mcp"
      ],
      "command": "vp"
    },
    "vibe-vault": {
      "args": [
        "mcp"
      ],
      "command": "vv"
    }
  },
  "language_models": {
    "completion": {
      "default_model": "grok-4",
      "inline_assistant": {
        "enabled": true,
        "model": "grok-4"
      },
      "provider": "xai",
      "thread": {
        "model": "grok-4"
      }
    },
    "providers": {
      "xai": {
        "models": [
          {
            "model": "grok-4",
            "name": "Grok 4"
          },
          {
            "max_tokens": 8192,
            "model": "grok-code-fast-1",
            "name": "Grok Code Fast 1",
            "temperature": 0.7
          }
        ]
      }
    }
  },
  "ssh_connections": [
    {
      "args": [],
      "host": "um791",
      "projects": [
        {
          "paths": [
            "/home/johns/code/proteus"
          ]
        },
        {
          "paths": [
            "/home/johns/code/proteus/proteus-rs"
          ]
        }
      ]
    }
  ],
  "terminal": {
    "dock": "bottom",
    "shell": {
      "program": "/bin/bash"
    }
  },
  "theme": {
    "dark": "One Dark",
    "light": "Ayu Dark",
    "mode": "system"
  },
  "ui_font_size": 16,
  "vim_mode": true,
  "which_key": {
    "enabled": true
  }
}
