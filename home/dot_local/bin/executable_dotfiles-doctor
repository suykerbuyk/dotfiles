#!/bin/sh
# dotfiles-doctor — trampoline into the checkout's ./doctor management CLI.
# Implementation lives at the repo root (see ./doctor). Applied to
# ~/.local/bin/dotfiles-doctor for use from any directory after apply.
set -eu

resolve_root() {
	cfg="${HOME}/.config/chezmoi/chezmoi.toml"
	if [ -r "$cfg" ]; then
		src=$(sed -n 's/^[[:space:]]*sourceDir[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$cfg" | head -1)
		if [ -n "$src" ] && [ -d "$src" ]; then
			dirname "$src"
			return 0
		fi
	fi
	cm=
	if [ -x "${HOME}/.local/bin/chezmoi" ]; then
		cm=${HOME}/.local/bin/chezmoi
	elif command -v chezmoi >/dev/null 2>&1; then
		cm=$(command -v chezmoi)
	fi
	if [ -n "$cm" ]; then
		src=$("$cm" source-path 2>/dev/null) || src=
		if [ -n "$src" ] && [ -d "$src" ]; then
			dirname "$src"
			return 0
		fi
	fi
	return 1
}

root=$(resolve_root) || {
	echo "dotfiles-doctor: cannot find the dotfiles checkout (set sourceDir in ~/.config/chezmoi/chezmoi.toml)" >&2
	exit 1
}
[ -x "$root/doctor" ] || {
	echo "dotfiles-doctor: missing $root/doctor" >&2
	exit 1
}
exec "$root/doctor" "$@"
