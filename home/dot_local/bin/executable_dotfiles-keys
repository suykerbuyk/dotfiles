#!/usr/bin/env bash
# dotfiles-keys — manage the age-encrypted secrets file (~/.keys).
#
# Your API keys live ENCRYPTED in the dotfiles repo (encrypted_private_dot_keys.age)
# and are decrypted to ~/.keys (mode 0600) by `chezmoi apply`. This is the one
# command to remember for anything secrets-related — you never touch chezmoi or
# age directly.
#
#   dotfiles-keys            edit ~/.keys: opens it DECRYPTED in $EDITOR, then
#   dotfiles-keys edit       re-encrypts + applies on save, and reminds you to push
#   dotfiles-keys status     is the age key present? is ~/.keys decrypted?
#   dotfiles-keys show       list variable NAMES only (never values)
#   dotfiles-keys get-key     restore the age identity from 1Password
#
# The age identity lives at ~/.config/chezmoi/key.txt (0600) and is mirrored in
# 1Password as the document "dotfiles age key" (vault: Personal).
set -euo pipefail

KEY="$HOME/.config/chezmoi/key.txt"
KEYS="$HOME/.keys"
OP_ITEM="dotfiles age key"
OP_VAULT="Personal"

die() { echo "dotfiles-keys: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

repo_root() { have chezmoi && dirname "$(chezmoi source-path 2>/dev/null)" 2>/dev/null || true; }

cmd_get_key() {
    [ -r "$KEY" ] && { echo "age key already present: $KEY"; return 0; }
    have op || die "1Password CLI (op) not installed — paste the key into $KEY by hand (chmod 600)."
    umask 077; mkdir -p "$(dirname "$KEY")"
    op document get "$OP_ITEM" --vault "$OP_VAULT" --out-file "$KEY" \
        || die "could not fetch '$OP_ITEM' from 1Password (signed in? op signin)"
    chmod 600 "$KEY"
    echo "Restored age identity from 1Password -> $KEY"
}

cmd_status() {
    if [ -r "$KEY" ]; then echo "age key:  present ($KEY)"
    else echo "age key:  MISSING — restore it:  dotfiles-keys get-key"; fi
    if [ -r "$KEYS" ]; then
        printf '~/.keys:  present, mode %s, %s entries\n' \
            "$(stat -c %a "$KEYS" 2>/dev/null)" \
            "$(grep -cE '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$KEYS" 2>/dev/null || echo 0)"
    else echo "~/.keys:  absent (not decrypted — run: dotfiles-keys get-key, then re-apply)"; fi
}

cmd_show() {
    [ -r "$KEYS" ] || die "~/.keys absent."
    echo "Defined variables (names only):"
    grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$KEYS" \
        | sed -E 's/=$//; s/^[[:space:]]*(export[[:space:]]+)?/  /' | sort -u
}

cmd_edit() {
    have chezmoi || die "chezmoi not installed — run the dotfiles installer first."
    [ -r "$KEY" ] || die "age key missing — restore it first:  dotfiles-keys get-key"
    chezmoi edit --apply "$KEYS"
    echo
    echo "Edited, re-encrypted, and applied. Publish the change:"
    local root; root="$(repo_root)"
    if [ -n "$root" ]; then
        echo "  (cd \"$root\" && git add -A && git commit -m 'update keys' && git push)"
    else
        echo "  commit & push the encrypted_private_dot_keys.age change in your dotfiles repo"
    fi
}

case "${1:-edit}" in
    edit|"")   cmd_edit ;;
    status)    cmd_status ;;
    show)      cmd_show ;;
    get-key)   cmd_get_key ;;
    -h|--help) sed -n '2,20{/^#/{s/^# \{0,1\}//;p}}' "$0" ;;
    *)         die "unknown command '$1' (try: edit | status | show | get-key)" ;;
esac
