# ---------------------------------------------------------------------------
# Agent forwarding — PER HOST, never globally.
#
# Forwarding lets the REMOTE host use this machine's agent for onward auth. On a
# desktop running the 1Password app that means each signature raises an approval
# prompt HERE, which is exactly what you want when working on a GUI-less box from
# a windowing one: the approval surface stays where the human is.
#
# 🔴 It is not free. Root on the forwarded-to host can use the agent socket for
# as long as the session is open, so this is enabled only for hosts under our own
# control and NEVER in `Host *`.
#
# 🔴 For multi-hop use ProxyJump, never a chain of `ForwardAgent yes`. Under
# ProxyJump the intermediate host carries a tunnelled TCP connection and never
# sees the agent socket; only the final host gets forwarding. The prox-mgmt1
# block below already uses that shape.
#
# This only works because the rc layer stops discarding what gets forwarded:
# 10-ssh-agent.sh honours an inherited LIVE socket and env.sh only fills a gap
# (iter 66). Before that, arriving on a box running these dotfiles silently
# replaced the forwarded agent with a local one. See home/doc/ssh-agent.md.
#
# To extend: add a `Host <name>` block here with `ForwardAgent yes`, above the
# `Host *` block. Verify with `ssh -G <name> | grep forwardagent`.
Host vault01
    ForwardAgent yes

# ---------------------------------------------------------------------------
# IdentitiesOnly — stop the agent flooding a server with every key it holds.
#
# With `IdentitiesOnly no` (the default) ssh offers EVERY key the agent holds
# before it touches any IdentityFile. Measured against a throwaway sshd with the
# stock `MaxAuthTries 6`: an 8-key agent queued 14 candidates, got 6 offers in,
# and was disconnected with "Too many authentication failures" having never
# reached the authorised key. The 1Password agent here serves THIRTEEN, so this
# is not hypothetical — it is the failure waiting for any host that wants a key
# late in the agent's ordering.
#
# `IdentitiesOnly yes` restricts the offers to the identities named in config.
# Naming a PUBLIC key is the important half: ssh matches it against the agent and
# lets the AGENT sign, so the private key never has to be on disk. Measured on
# the same sshd: 1 offer, rc 0, "Server accepts key ... explicit agent".
#
# IdentityFile is CUMULATIVE (unlike IdentityAgent, which is first-wins), so the
# `~/.ssh/id_ed25519` from the `Host *` block below is still offered here — that
# is deliberate, it is the key GitHub actually accepts (verified: "Server accepts
# key: /home/johns/.ssh/id_ed25519 ... Hi suykerbuyk!").
Host github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519.pub

# The Teleport hosts need the same restriction, and it matters MORE there: they
# are pinned to the 1Password agent by the block at the foot of this file, so
# without this they are offered all thirteen of its keys before the Teleport
# certificate is ever tried — the certificate being the only thing that can
# actually authenticate them.
#
# 🔴 This block is SEPARATE from, and ABOVE, the "generated by tsh" section on
# purpose. `tsh config` rewrites that section wholesale (it is already the reason
# the absolute-path ProxyCommand keeps reappearing as drift), so a setting placed
# inside it would be silently reverted on the next Teleport touch.
# IdentitiesOnly is first-wins, so being above is what makes this stick.
#
# ⚠ UNVERIFIED against a live connection. The Teleport certificate on this host
# expired 2026-09-04, so there is nothing to connect with until a fresh
# `tsh login`, and failed attempts count toward CLUSTER LOCKOUT — so this must
# not be probed by retrying (home/doc/teleport.md). It is strictly narrowing:
# it can only reduce what is offered, and what remains is the tsh key plus its
# certificate. If a syketech host ever refuses a valid certificate, delete these
# two lines first and re-test.
Host *.syketech.com syketech.com
    IdentitiesOnly yes

# 🔴 ssh_config is FIRST-WINS per keyword, with no specificity ranking: the first
# value seen for a keyword wins, even if a later block matches the host more
# narrowly. Measured with `ssh -G` on OpenSSH 10.5p1, for IdentityAgent
# specifically, in both block orderings.
#
# So this block must NEVER gain an `IdentityAgent`. Two things happen if it does,
# and the first is the one that bites:
#
#   1. EVERY host inherits that agent. Measured: adding it here made github.com
#      resolve to the 1Password socket, so a locked app breaks git over ssh on a
#      machine that never asked for 1Password.
#   2. The per-host block at the foot of this file becomes dead code — it can no
#      longer change the value. Today both name the same socket, so that half is
#      INVISIBLE; it only surfaces the day the two values differ.
#
# ssh reports none of this at any verbosity. `ssh -G` is the only thing that shows
# it, which is why the harness asserts the absence.
#
# A per-host agent opt-in therefore goes ABOVE this block, never below it.
# Note also that IdentityFile is CUMULATIVE where IdentityAgent is first-wins, so
# a per-host IdentityFile does not displace the one below — both get offered.
Host *
ControlMaster auto
ControlPath ~/.ssh/sockets/%r@%h-%p
ControlPersist 1
IdentityFile = ~/.ssh/id_ed25519
AddKeysToAgent yes

# Begin generated Teleport configuration for syketech.com by tsh

# Common flags for all syketech.com hosts
Host *.syketech.com syketech.com
    UserKnownHostsFile "~/.tsh/known_hosts"
    #UserKnownHostsFile=/dev/null
    StrictHostKeyChecking=no
    IdentityFile "~/.tsh/keys/syketech.com/suykerbuyk"
    CertificateFile "~/.tsh/keys/syketech.com/suykerbuyk-ssh/syketech.com-cert.pub"
    User johns

# Flags for all syketech.com hosts except the proxy
Host *.syketech.com !syketech.com
    Port 3022
    ProxyCommand "tsh" proxy ssh --cluster=syketech.com --proxy=syketech.com:443 %r@%h:%p

# End generated Teleport configuration


# ---------------------------------------------------------------------------
# Kearns lab / hal9k — when Teleport reverse-tunnel on prox is down
# Path: laptop --tsh--> root@hal9k-rpi04.syketech.com --ssh--> root@10.50.10.25
#
#   ssh prox-mgmt1-via-rpi                 # ProxyJump (needs your pubkey on prox)
#   ssh prox-mgmt1-nested "command"        # always works (auth as rpi04 root)
# ---------------------------------------------------------------------------
Host hal9k-rpi04
    HostName hal9k-rpi04.syketech.com
    User root

Host prox-mgmt1-via-rpi prox-mgmt1
    HostName 10.50.10.25
    User root
    Port 22
    ProxyJump root@hal9k-rpi04.syketech.com
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts.hal9k
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly no

Host prox-mgmt1-nested
    HostName 10.50.10.25
    User root
    # TCP pipe via rpi; auth still from this laptop (same as via-rpi).
    ProxyCommand ssh -o BatchMode=yes -W %h:%p root@hal9k-rpi04.syketech.com
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts.hal9k


Host 10.*
UserKnownHostsFile = /dev/null
StrictHostKeyChecking = no

Host qb*
UserKnownHostsFile = /dev/null
StrictHostKeyChecking = no
User johns
IdentityFile = ~/.ssh/id_ed25519

